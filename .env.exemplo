# Copie este arquivo para ".env" (mesma pasta) e preencha. O .env não deve ser compartilhado.
# No painel do Supabase: botão "Connect" > "Session pooler" > copie a string e troque a senha.
# Caracteres especiais na senha precisam ser codificados:  @ -> %40   # -> %23   / -> %2F   ? -> %3F
DATABASE_URL=postgresql://USUARIO:SUA-SENHA@HOST:5432/postgres

# Opcional (recomendado): certificado do banco para verificar a conexão
# (painel do Supabase > Project Settings > Database > SSL Configuration > Download certificate)
# DATABASE_CA=C:\caminho\prod-ca.crt
